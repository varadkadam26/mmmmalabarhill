<%- include('partials/header') %>

  <section class="page-hero-banner">
    <div class="container">
      <h1 data-i18n="donate_title">ऑनलाइन देणगी पोर्टल</h1>
    </div>
  </section>

  <section class="main-content-gradient" style="padding: 5rem 0;">
    <div class="container" style="max-width: 850px;">

      <div class="card-temple" style="padding: 3rem;">
        <h2 style="font-size: 1.8rem; color: var(--temple-maroon); margin-bottom: 1.5rem; text-align: center;"
          data-i18n="donate_form_title">
          देणगी नोंदणी फॉर्म
        </h2>

        <form id="donationForm">
          <!-- Custom Amount -->
          <div style="margin-bottom: 1.5rem;">
            <label
              style="display: block; font-size: 0.9rem; font-weight: 700; margin-bottom: 0.4rem; color: var(--text-main);"
              data-i18n="lbl_custom_amount">
              देणगी रक्कम टाका (₹) *
            </label>
            <input type="number" id="donationAmount" min="11" required placeholder="रक्कम टाका (उदा. ५०१)"
              style="width: 100%; padding: 0.85rem 1.2rem; border-radius: var(--radius-sm); border: 1px solid var(--border-gold); font-size: 1.1rem; font-weight: 700; color: var(--temple-maroon);">
          </div>

          <!-- Donor Name -->
          <div style="margin-bottom: 1.5rem;">
            <label
              style="display: block; font-size: 0.9rem; font-weight: 700; margin-bottom: 0.4rem; color: var(--text-main);"
              data-i18n="lbl_donor_name">
              देणगीदाराचे संपूर्ण नाव *
            </label>
            <input type="text" id="donorName" required placeholder="संपूर्ण नाव टाका" data-i18n="ph_donor_name"
              style="width: 100%; padding: 0.75rem 1rem; border-radius: var(--radius-sm); border: 1px solid var(--border-gold); font-size: 0.95rem;">
          </div>

          <!-- Contact Phone & Email -->
          <div class="form-grid-2" style="margin-bottom: 1.5rem;">
            <div>
              <label
                style="display: block; font-size: 0.9rem; font-weight: 700; margin-bottom: 0.4rem; color: var(--text-main);"
                data-i18n="lbl_mobile">
                मोबाईल नंबर *
              </label>
              <input type="tel" id="donorPhone" required placeholder="१० अंकी मोबाईल नंबर" data-i18n="ph_mobile"
                style="width: 100%; padding: 0.75rem 1rem; border-radius: var(--radius-sm); border: 1px solid var(--border-gold); font-size: 0.95rem;">
            </div>

            <div>
              <label
                style="display: block; font-size: 0.9rem; font-weight: 700; margin-bottom: 0.4rem; color: var(--text-main);"
                data-i18n="lbl_email">
                ईमेल आयडी (पावतीसाठी)
              </label>
              <input type="email" id="donorEmail" placeholder="पावती मिळण्यासाठी ईमेल प्रविष्ट करा" data-i18n="ph_email"
                style="width: 100%; padding: 0.75rem 1rem; border-radius: var(--radius-sm); border: 1px solid var(--border-gold); font-size: 0.95rem;">
            </div>
          </div>

          <!-- Payment UTR Number (Compulsory) -->
          <div style="margin-bottom: 2rem;">
            <label
              style="display: block; font-size: 0.9rem; font-weight: 700; margin-bottom: 0.4rem; color: var(--text-main);">
              पेमेंट UTR / व्यवहार क्रमांक (Payment UTR No) *
            </label>
            <input type="text" id="paymentUtrNo" required placeholder="१२ अंकी UTR नंबर प्रविष्ट करा (उदा. 423456789012)"
              style="width: 100%; padding: 0.75rem 1rem; border-radius: var(--radius-sm); border: 1px solid var(--border-gold); font-size: 0.95rem; font-family: monospace; font-weight: bold;">
            <small style="color: #666; font-size: 0.8rem; display: block; margin-top: 4px;">
              <i class="bi bi-info-circle"></i> UPI / बँक ट्रान्सफर केल्यानंतर मिळणारा १२ अंकी UTR नंबर येथे प्रविष्ट करा.
            </small>
          </div>

          <button type="submit" class="btn btn-primary"
            style="width: 100%; padding: 1rem; font-size: clamp(0.95rem, 4vw, 1.1rem); font-weight: 800; white-space: normal; line-height: 1.3;" id="btnDonateSubmit">
            <span>देणगी नोंदवा</span> <i class="bi bi-shield-check"></i>
          </button>
        </form>
      </div>

      <!-- UPI Scan & Pay Card Section -->
      <div class="card-temple" style="padding: 2.5rem; margin-top: 3rem; text-align: center; background: #FFFFFF; border: 2px solid var(--royal-gold); box-shadow: var(--shadow-md);">
        <div style="background: rgba(212, 175, 55, 0.1); border-radius: var(--radius-md); padding: 1rem 1.5rem; margin-bottom: 1.5rem; display: inline-block;">
          <span style="font-size: 0.85rem; font-weight: 800; text-transform: uppercase; color: var(--primary-saffron); letter-spacing: 1px;">
            SVC CO-OPERATIVE BANK LTD.
          </span>
          <h3 style="font-size: 1.4rem; color: var(--temple-maroon); margin: 0.2rem 0 0; font-family: var(--font-en-head);">
            SCAN & PAY VIA UPI
          </h3>
        </div>

        <div style="display: flex; flex-direction: column; align-items: center; justify-content: center; gap: 1rem; margin-bottom: 1.5rem;">
          <div style="padding: 12px; background: #FFFFFF; border: 2px solid var(--royal-gold); border-radius: 12px; box-shadow: var(--shadow-sm); display: inline-block;">
            <img src="https://api.qrserver.com/v1/create-qr-code/?size=220x220&data=upi%3A%2F%2Fpay%3Fpa%3DSVCMERC00301799%40svcbank%26pn%3DShree%2520Bal%2520Gopal%2520Ganeshutsav%2520Mandal%26cu%3DINR" 
              alt="SVC Bank UPI QR Code for Malabar Hill Cha Raja" 
              style="width: 200px; height: 200px; display: block;">
          </div>
          
          <div style="background: var(--bg-cream); border: 1.5px solid var(--border-gold); padding: 0.8rem 1.4rem; border-radius: 50px; display: inline-flex; align-items: center; gap: 10px; max-width: 100%;">
            <i class="fa-solid fa-qrcode" style="color: var(--primary-saffron); font-size: 1.2rem;"></i>
            <span style="font-family: monospace; font-size: 1.05rem; font-weight: 800; color: var(--temple-maroon); word-break: break-all;" id="textUpiId">
              SVCMERC00301799@svcbank
            </span>
            <button type="button" onclick="navigator.clipboard.writeText('SVCMERC00301799@svcbank'); alert('UPI ID Copied: SVCMERC00301799@svcbank');" 
              style="background: var(--temple-maroon); color: #FFF; border: none; padding: 4px 12px; border-radius: 20px; font-size: 0.78rem; font-weight: 700; cursor: pointer; white-space: nowrap;">
              <i class="fa-regular fa-copy"></i> Copy
            </button>
          </div>
        </div>

        <div style="display: flex; justify-content: center; align-items: center; gap: 1rem; flex-wrap: wrap; margin-top: 1rem; font-size: 0.85rem; font-weight: 700; color: var(--text-muted);">
          <span><i class="fa-solid fa-check-circle" style="color: #16A34A;"></i> Google Pay</span>
          <span><i class="fa-solid fa-check-circle" style="color: #16A34A;"></i> PhonePe</span>
          <span><i class="fa-solid fa-check-circle" style="color: #16A34A;"></i> Paytm</span>
          <span><i class="fa-solid fa-check-circle" style="color: #16A34A;"></i> BHIM UPI</span>
        </div>
      </div>

      <!-- Bank Details Section -->
      <div class="card-temple" style="padding: 3rem; margin-top: 2.5rem;">
        <h2 style="font-size: 1.8rem; color: var(--temple-maroon); margin-bottom: 1.5rem; text-align: center;">
          <span data-i18n="bank_details_title">बँक खाते तपशील / Bank Account Details</span>
        </h2>
        
        <div style="background: var(--bg-cream); border: 1px solid var(--border-gold); padding: 2rem; border-radius: var(--radius-sm); font-size: 1.1rem; line-height: 1.8; color: var(--text-dark);">
          <div style="display: flex; flex-direction: column; gap: 0.8rem;">
            <div style="display: flex; flex-wrap: wrap; gap: 1rem; justify-content: space-between; border-bottom: 1px dashed var(--border-gold); padding-bottom: 0.5rem;">
              <strong style="color: var(--temple-maroon);"><span data-i18n="bank_name_lbl">बँकेचे नाव:</span></strong>
              <span>SVC Co-Operative Bank Ltd.</span>
            </div>
            <div style="display: flex; flex-wrap: wrap; gap: 1rem; justify-content: space-between; border-bottom: 1px dashed var(--border-gold); padding-bottom: 0.5rem;">
              <strong style="color: var(--temple-maroon);"><span data-i18n="acc_name_lbl">खात्याचे नाव:</span></strong>
              <span>Shree Bal Gopal Ganeshutsav Mandal (Bal Gopal Mandal)</span>
            </div>
            <div style="display: flex; flex-wrap: wrap; gap: 1rem; justify-content: space-between; border-bottom: 1px dashed var(--border-gold); padding-bottom: 0.5rem;">
              <strong style="color: var(--temple-maroon);"><span>UPI ID:</span></strong>
              <span style="font-family: monospace; font-size: 1.15rem; font-weight: bold; color: var(--primary-saffron);">SVCMERC00301799@svcbank</span>
            </div>
            <div style="display: flex; flex-wrap: wrap; gap: 1rem; justify-content: space-between; border-bottom: 1px dashed var(--border-gold); padding-bottom: 0.5rem;">
              <strong style="color: var(--temple-maroon);"><span data-i18n="acc_no_lbl">खाते क्रमांक:</span></strong>
              <span style="font-family: monospace; font-size: 1.2rem; font-weight: bold;">100903130041974</span>
            </div>
            <div style="display: flex; flex-wrap: wrap; gap: 1rem; justify-content: space-between; border-bottom: 1px dashed var(--border-gold); padding-bottom: 0.5rem;">
              <strong style="color: var(--temple-maroon);"><span data-i18n="ifsc_lbl">आयएफएससी कोड:</span></strong>
              <span style="font-family: monospace; font-size: 1.2rem; font-weight: bold;">SVCB0000009</span>
            </div>
            <div style="display: flex; flex-wrap: wrap; gap: 1rem; justify-content: space-between; border-bottom: 1px dashed var(--border-gold); padding-bottom: 0.5rem;">
              <strong style="color: var(--temple-maroon);"><span data-i18n="branch_lbl">शाखा:</span></strong>
              <span>Sleater Road</span>
            </div>
          </div>
        </div>
      </div>

    </div>
  </section>

  <!-- Confirmation Success Modal -->
  <div id="donationSuccessModal" style="display: none; position: fixed; inset: 0; background: rgba(0,0,0,0.7); z-index: 99999; align-items: center; justify-content: center; padding: 1rem;">
    <div style="background: #FFFFFF; border: 3px solid var(--royal-gold); border-radius: var(--radius-lg); max-width: 500px; width: 100%; padding: 2.5rem; text-align: center; box-shadow: 0 20px 50px rgba(0,0,0,0.4);">
      <div style="width: 70px; height: 70px; background: #D1FAE5; color: #059669; border-radius: 50%; display: flex; align-items: center; justify-content: center; font-size: 2.2rem; margin: 0 auto 1.2rem;">
        <i class="fa-solid fa-circle-check"></i>
      </div>
      <h3 style="color: var(--temple-maroon); font-size: 1.5rem; margin-bottom: 0.6rem;">तुमची देणगी नोंदणी यशस्वी झाली आहे!</h3>
      <p style="color: #4B5563; font-size: 0.95rem; line-height: 1.6; margin-bottom: 1.5rem;">
        मंडळाच्या बँक पडताळणीनंतर (Admin Approval) तुमची अधिकृत <strong>८०जी PDF पावती</strong> तुमच्या ईमेलवर पाठवली जाईल.
      </p>
      <div style="background: var(--bg-cream); border: 1px dashed var(--border-gold); padding: 1rem; border-radius: 8px; margin-bottom: 1.8rem; font-size: 0.9rem; text-align: left;">
        <div><strong>पावती क्रमांक:</strong> <span id="modalReceiptNo" style="font-family: monospace; font-weight: bold; color: var(--temple-maroon);"></span></div>
        <div><strong>पडताळणी स्थिती:</strong> <span style="color: #D97706; font-weight: bold;">पडताळणी प्रलंबित (Pending Admin Approval)</span></div>
      </div>
      <button type="button" class="btn btn-primary" onclick="window.location.reload();" style="width: 100%; padding: 0.85rem; font-weight: bold;">
        ठीक आहे (OK)
      </button>
    </div>
  </div>

  <script>
    document.addEventListener('DOMContentLoaded', () => {
      const donationForm = document.getElementById('donationForm');
      if (!donationForm) return;

      donationForm.addEventListener('submit', async (e) => {
        e.preventDefault();
        const btn = document.getElementById('btnDonateSubmit');
        const btnTextSpan = btn.querySelector('span');
        btn.disabled = true;

        if (btnTextSpan) {
          btnTextSpan.textContent = 'नोंदणी होत आहे... (Submitting)';
        } else {
          btn.textContent = 'नोंदणी होत आहे... (Submitting)';
        }

        const amountVal = document.getElementById('donationAmount').value;
        const donorName = document.getElementById('donorName').value;
        const donorPhone = document.getElementById('donorPhone').value;
        const donorEmail = document.getElementById('donorEmail').value;
        const paymentUtr = document.getElementById('paymentUtrNo').value;

        try {
          const res = await fetch('/api/submit-donation', {
            method: 'POST',
            headers: { 'Content-Type': 'application/json' },
            body: JSON.stringify({
              amount: amountVal,
              donor_name: donorName,
              phone: donorPhone,
              email: donorEmail,
              payment_utr: paymentUtr
            })
          });

          const data = await res.json();
          if (data.success) {
            document.getElementById('modalReceiptNo').textContent = data.receipt_no;
            const modal = document.getElementById('donationSuccessModal');
            if (modal) modal.style.display = 'flex';
          } else {
            alert(data.message || 'देणगी नोंदवताना त्रुटी आली.');
            btn.disabled = false;
            if (btnTextSpan) btnTextSpan.textContent = 'देणगी नोंदवा';
          }
        } catch (err) {
          console.error('Submission error:', err);
          alert('नेटवर्क किंवा सर्वर त्रुटी आली.');
          btn.disabled = false;
          if (btnTextSpan) btnTextSpan.textContent = 'देणगी नोंदवा';
        }
      });
    });
  </script>

<%- include('partials/footer') %>