<!DOCTYPE html>
<html lang="<%= typeof lang !== 'undefined' ? lang : 'mr' %>">
<head>
  <meta charset="UTF-8">
  <meta name="viewport" content="width=device-width, initial-scale=1, maximum-scale=5, viewport-fit=cover">
  <meta name="theme-color" content="#7F1D1D">
  <meta name="apple-mobile-web-app-capable" content="yes">
  <meta name="apple-mobile-web-app-status-bar-style" content="black-translucent">
  <meta name="apple-mobile-web-app-title" content="Malabar Hill Cha Raja">
  <title><%= typeof title !== 'undefined' ? title : 'Malabar Hill Cha Raja | Shree Bal Gopal Ganeshutsav Mandal, Mumbai' %></title>
  <!-- Google Search Console Ownership Verification -->
  <meta name="google-site-verification" content="-La0Qcl3mNPWA_VzETqJiTZj5LkxDA9CygyqMylTeuY">
  <meta name="google-site-verification" content="660I70yKDwuyHiRbH-kyytKeHowTLgUQtc67gmOonAE">
  
  <%
    var defaultDesc = 'Official Portal of Malabar Hill Cha Raja (Shree Bal Gopal Ganeshutsav Mandal, Est. 1973, Reg. F-11518). Daily Ganeshotsav live darshan, schedule, historical photo gallery, social work & 80G tax exempt donations.';
    var pageDesc = typeof metaDescription !== 'undefined' ? metaDescription : defaultDesc;
    var currentTabName = typeof activeTab !== 'undefined' ? activeTab : 'home';
    var currentPath = currentTabName !== 'home' 
      ? (currentTabName === 'socialwork' ? '/social-work' : currentTabName === 'photobooth' ? '/glimpses' : '/' + currentTabName) 
      : '';
    var canonicalUrl = 'https://malabarhillcharaja.in' + currentPath;

    var breadcrumbs = [
      { "@type": "ListItem", "position": 1, "name": "Home", "item": "https://malabarhillcharaja.in/" }
    ];
    if (currentTabName !== 'home') {
      var tabLabelMap = {
        'about': 'About Us',
        'schedule': 'Schedule',
        'glimpses': 'Glimpses',
        'photobooth': 'Glimpses',
        'socialwork': 'Social Work',
        'committee': 'Committee',
        'advertisement': 'Advertisement',
        'contact': 'Contact',
        'tshirt': 'Official T-Shirt',
        'donate': 'Donate'
      };
      var label = tabLabelMap[currentTabName] || 'Page';
      breadcrumbs.push({
        "@type": "ListItem",
        "position": 2,
        "name": label,
        "item": canonicalUrl
      });
    }
  %>
  <meta name="description" content="<%= pageDesc %>">
  <!-- Canonical & Open Graph Meta Tags -->
  <link rel="canonical" href="<%= canonicalUrl %>">
  <meta property="og:title" content="<%= typeof title !== 'undefined' ? title : 'Malabar Hill Cha Raja | Shree Bal Gopal Ganeshutsav Mandal' %>">
  <meta property="og:description" content="<%= pageDesc %>">
  <meta property="og:image" content="https://malabarhillcharaja.in/images/malabar_ganpati_01.jpg">
  <meta property="og:url" content="<%= canonicalUrl %>">
  <meta property="og:type" content="website">
  <meta property="og:site_name" content="Malabar Hill Cha Raja">
  <meta property="og:locale" content="<%= typeof lang !== 'undefined' && lang === 'mr' ? 'mr_IN' : 'en_US' %>">
  <meta name="twitter:card" content="summary_large_image">
  <meta name="twitter:title" content="<%= typeof title !== 'undefined' ? title : 'Malabar Hill Cha Raja | Shree Bal Gopal Ganeshutsav Mandal' %>">
  <meta name="twitter:description" content="<%= pageDesc %>">
  <meta name="twitter:image" content="https://malabarhillcharaja.in/images/malabar_ganpati_01.jpg">

  <!-- LCP Image Preload for Instant First Contentful Render -->
  <link rel="preload" as="image" href="/images/malabar_ganpati_new1.webp" type="image/webp" fetchpriority="high">
  
