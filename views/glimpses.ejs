<%- include('partials/header') %>

  <section class="page-hero-banner">
    <div class="container">
      <h1>
        <span class="lang-mr">क्षणचित्रे व दशकातील सुवर्ण प्रवास</span>
        <span class="lang-en">Glimpses & Golden Journey of a Decade</span>
      </h1>
    </div>
  </section>

  <!-- Featured 3D Interactive Scroll Reel -->
  <section
    style="background: linear-gradient(180deg, #160303 0%, #0A0A0A 100%); padding: 3.5rem 0 2.5rem; border-bottom: 2px solid var(--royal-gold); position: relative; overflow: hidden;">
    <div class="container">
      <div
        style="display: flex; justify-content: space-between; align-items: center; margin-bottom: 1rem; flex-wrap: wrap; gap: 1rem;">
        <h2
          style="font-size: 1.6rem; color: var(--gold-soft); margin: 0; display: flex; align-items: center; gap: 10px;">
          <i class="fa-solid fa-crown" style="color: var(--royal-gold);"></i>
          <span>
            <span class="lang-mr">दशकातील स्वर्णिम क्षणचित्रे (3D Retrospective Reel)</span>
            <span class="lang-en">Golden Moments of the Decade (3D Retrospective Reel)</span>
          </span>
        </h2>
        <span style="font-size: 0.85rem; color: var(--gold-soft); font-weight: 600; opacity: 0.85;">
          <i class="fa-solid fa-hand-pointer" style="margin-right: 4px;"></i> Drag or Scroll 3D Cards →
        </span>
      </div>

      <div class="crazy-reel-wrapper">
        <button class="crazy-reel-nav-btn prev" aria-label="Previous Slide">
          <i class="fa-solid fa-chevron-left"></i>
        </button>

        <div class="crazy-reel-container">
          <% glimpsesData.forEach(item=> { %>
            <% if (!item.hideFromReel) { %>
            <div class="crazy-reel-card gold-motion-frame" data-lightbox data-lightbox-src="<%= item.image %>"
              data-lightbox-title="<%= item.titleMr || item.title %> (वर्ष <%= item.year %>)"
              data-lightbox-title-mr="<%= item.titleMr || item.title %> (वर्ष <%= item.year %>)"
              data-lightbox-title-en="<%= item.titleEn || item.title %> (Year <%= item.year %>)"
              data-lightbox-caption="<%= item.descMr || item.desc %>"
              data-lightbox-caption-mr="<%= item.descMr || item.desc %>"
              data-lightbox-caption-en="<%= item.descEn || item.desc %>">
              <div class="card-img-box">
                <img src="<%= item.image %>" alt="<%= item.titleMr || item.title %>" loading="lazy"
                  style="width: 100%; height: 100%; object-fit: cover;">
                <div class="year-badge"><span class="lang-mr">वर्ष</span><span class="lang-en">Year</span>
                  <%= item.year %>
                </div>
                <div class="enlarge-hint">
                  <i class="fa-solid fa-magnifying-glass-plus" style="color: var(--royal-gold); margin-right: 4px;"></i>
                  <span class="lang-mr">झूम करा</span>
                  <span class="lang-en">Enlarge</span>
                </div>
              </div>
              <div class="card-content">
                <h4 class="card-title"><span class="lang-mr">
                    <%= item.titleMr || item.title %>
                  </span><span class="lang-en">
                    <%= item.titleEn || item.title %>
                  </span></h4>
                <p class="card-subtitle"><span class="lang-mr">
                    <%= item.themeMr || item.theme %>
                  </span><span class="lang-en">
                    <%= item.themeEn || item.theme %>
                  </span></p>
              </div>
            </div>
            <% } %>
            <% }); %>
        </div>

        <button class="crazy-reel-nav-btn next" aria-label="Next Slide">
          <i class="fa-solid fa-chevron-right"></i>
        </button>
      </div>
    </div>
  </section>

  <!-- Gallery Filter Bar & Grid -->
  <section class="main-content-gradient" style="padding: 4rem 0;">
    <div class="container">



      <div class="grid-3">
        <% glimpsesData.forEach(item=> { %>
          <div class="card-temple gallery-card-item gold-motion-frame reveal-on-scroll"
            data-category="<%= item.category %>"
            style="padding: 0; overflow: hidden; display: flex; flex-direction: column;">
            <div style="position: relative; height: 350px; overflow: hidden; background: #0A0A0A; cursor: pointer;"
              data-lightbox data-lightbox-src="<%= item.image %>"
              data-lightbox-title="<%= item.titleMr || item.title %> (वर्ष <%= item.year %>)"
              data-lightbox-title-mr="<%= item.titleMr || item.title %> (वर्ष <%= item.year %>)"
              data-lightbox-title-en="<%= item.titleEn || item.title %> (Year <%= item.year %>)"
              data-lightbox-caption="<%= item.descMr || item.desc %>"
              data-lightbox-caption-mr="<%= item.descMr || item.desc %>"
              data-lightbox-caption-en="<%= item.descEn || item.desc %>">
              <img src="<%= item.image %>" alt="<%= item.title %>"
                style="width: 100%; height: 100%; object-fit: cover;">
            </div>
            <div
              style="padding: 1.8rem; flex-grow: 1; display: flex; flex-direction: column; justify-content: space-between;">
              <div>
                <h3 style="font-size: 1.3rem; color: var(--temple-maroon); margin-bottom: 0.6rem;"><span
                    class="lang-mr">
                    <%= item.titleMr || item.title %>
                  </span><span class="lang-en">
                    <%= item.titleEn || item.title %>
                  </span></h3>
                <p style="font-size: 0.92rem; color: var(--text-muted); line-height: 1.7; margin-bottom: 1.2rem;"><span
                    class="lang-mr">
                    <%= item.descMr || item.desc %>
                  </span><span class="lang-en">
                    <%= item.descEn || item.desc %>
                  </span></p>
              </div>


            </div>
          </div>
          <% }); %>
      </div>
    </div>
  </section>

  <%- include('partials/footer') %>