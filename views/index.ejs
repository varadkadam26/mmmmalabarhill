          <button class="crazy-reel-nav-btn prev" aria-label="Previous Slide">
            <i class="fa-solid fa-chevron-left"></i>
          </button>

          <div class="crazy-reel-container">
            <% (typeof glimpsesData !=='undefined' ? glimpsesData : []).forEach(item=> { %>
              <div class="crazy-reel-card gold-motion-frame gallery-card-item" data-category="<%= item.category %>"
                data-lightbox data-lightbox-src="<%= item.image %>"
                data-lightbox-title="<%= item.titleMr || item.title %> (Year <%= item.year %>)"
                data-lightbox-title-mr="<%= item.titleMr || item.title %> (वर्ष <%= item.year %>)"
                data-lightbox-title-en="<%= item.titleEn || item.title %> (Year <%= item.year %>)"
                data-lightbox-caption="<%= item.descMr || item.desc %>"
                data-lightbox-caption-mr="<%= item.descMr || item.desc %>"
                data-lightbox-caption-en="<%= item.descEn || item.desc %>">
                <div class="card-img-box">
                  <picture>
                    <source srcset="<%= item.image.replace(/\.(jpg|jpeg|png)$/, '.webp') %>" type="image/webp">
                    <img src="<%= item.image %>" alt="<%= item.title %>" width="360" height="240" loading="lazy"
                      style="width: 100%; height: 100%; object-fit: cover; object-position: center 15%;">
                  </picture>
                  <div class="year-badge"><span class="lang-mr">वर्ष</span><span class="lang-en">Year</span>
                    <%= item.year %>
                  </div>
                  <div class="enlarge-hint">
                    <i class="fa-solid fa-magnifying-glass-plus"
                      style="color: var(--royal-gold); margin-right: 4px;"></i>
                    <span class="lang-mr">झूम करा</span><span class="lang-en">Zoom Image</span>
                  </div>
                </div>
                <div class="card-content">
                  <h4 class="card-title" data-mr="<%= item.titleMr || item.title %>"
                    data-en="<%= item.titleEn || item.title %>">
                    <%= item.titleMr || item.title %>
                  </h4>
                  <p class="card-subtitle" data-mr="<%= item.themeMr || item.theme %>"
                    data-en="<%= item.themeEn || item.theme %>">
                    <%= item.themeMr || item.theme %>
                  </p>
                </div>
              </div>
              <% }); %>
          </div>

          <button class="crazy-reel-nav-btn next" aria-label="Next Slide">
            <i class="fa-solid fa-chevron-right"></i>
          </button>
        </div>

        <div style="text-align: center; margin-top: 3rem;">
