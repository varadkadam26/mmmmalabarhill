<%- include('partials/header') %>

  <!-- SECTION 3: FULL-BLEED HERO CAROUSEL -->
  <section class="hero-carousel" id="heroCarousel">
    <!-- Slide 1: New Idol 1 (LCP Image) -->
    <div class="hero-slide active">
      <picture>
        <source srcset="/images/malabar_ganpati_new1.webp" type="image/webp">
        <img src="/images/malabar_ganpati_new1.jpg" alt="Malabar Hill Cha Raja Silver Bappa Idol"
          class="hero-slide-bg hero-img-4" width="1200" height="800" fetchpriority="high" loading="eager"
          style="object-position: center center;">
      </picture>
    </div>
    <!-- Slide 2: New Idol 2 -->
    <div class="hero-slide">
      <picture>
        <source srcset="/images/malabar_ganpati_new2.webp" type="image/webp">
        <img src="/images/malabar_ganpati_new2.jpg" alt="Malabar Hill Cha Raja Idol" class="hero-slide-bg hero-img-5"
          width="1200" height="800" loading="lazy" style="object-position: center 15%;">
      </picture>
    </div>
    <!-- Slide 3: New Idol 3 -->
    <div class="hero-slide">
      <picture>
        <source srcset="/images/malabar_ganpati_new3.jpg?v=20260901_aagaman3" type="image/jpeg">
        <img src="/images/malabar_ganpati_new3.jpg?v=20260901_aagaman3" alt="Malabar Hill Cha Raja Idol"
          class="hero-slide-bg hero-img-6" width="1200" height="800" loading="lazy"
          style="object-position: center 30%;">
      </picture>
    </div>

    <!-- Hero Content Overlay -->
    <div class="hero-grid-container"
      style="position: absolute; top: 50%; left: 50%; transform: translate(-50%, -50%); z-index: 5; width: 90%; max-width: 1360px;">
      <div class="hero-content-left">
        <div class="hero-bg-watermark-text" aria-hidden="true">MALABAR HILL CHA RAJA</div>

        <div class="section-badge"
          style="position: relative; z-index: 2; background: rgba(201, 162, 39, 0.2); color: var(--gold-soft); border: none !important;">
          <span class="lang-mr">स्थापना १९७३ | नोंदणी क्र. एफ-११५१८</span>
          <span class="lang-en">ESTD 1973 | REG NO. F-11518</span>
        </div>

        <h1 class="hero-main-title">
          <span class="lang-mr">मलबार हिलचा राजा</span>
          <span class="lang-en">Malabar Hill Cha Raja</span>
        </h1>

        <p class="hero-sub-tag">
          <span class="lang-mr">स्वागतम</span><span class="lang-en">WARM WELCOME</span>
        </p>

        <p class="hero-subtitle-text">
          <span class="lang-mr">श्री बाल गोपाल गणेशोत्सव मंडळ</span>
          <span class="lang-en">Shree Bal Gopal Ganeshutsav Mandal</span>
        </p>

        <div class="hero-actions" style="margin-top: 1.8rem;">
          <a href="https://www.youtube.com/@MalabarHillChaRaja-e2z" target="_blank" rel="noopener noreferrer"
            class="btn btn-live-pulsing" id="btnHeroLiveDarshan"
            style="background: #7F1D1D !important; color: #FFFFFF !important; border: none; font-weight: 800;">
            <i class="fa-solid fa-play"></i>
            <span class="lang-mr">लाईव्ह दर्शन पहा</span>
            <span class="lang-en">Watch Live Darshan</span>
          </a>

          <a href="/donate" class="btn btn-primary donate-square-btn"
            style="background: #7F1D1D !important; color: #FFFFFF !important; border: none; font-weight: 800;">
            <span class="lang-mr">देणगी द्या</span>
            <span class="lang-en">Donate Now</span>
          </a>
        </div>
      </div>


    </div>

    <!-- Carousel Dot Indicators -->
    <div class="hero-carousel-dots">
      <div class="carousel-dot active" data-slide="0"></div>
      <div class="carousel-dot" data-slide="1"></div>
      <div class="carousel-dot" data-slide="2"></div>
    </div>

  </section>

